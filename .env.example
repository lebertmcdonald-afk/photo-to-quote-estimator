# Copy to .env.local and fill in from your Supabase project settings (API section).
# Only ever use the anon / public key here. Never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Prospect Hunter project. Read only, used by the /p/:slug preview pages.
VITE_PREVIEW_SUPABASE_URL=
VITE_PREVIEW_SUPABASE_ANON_KEY=
